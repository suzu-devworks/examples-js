{
  "name": "examples-js-vanilla",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "author": "A.suzuki <suzu.devworks@gmail.com>",
  "description": "Workspace for studying javascript programming.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suzu-devworks/examples-js-vanilla.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "simple-git-hooks",
    "lint": "pnpm run lint:style && pnpm run lint:es",
    "lint:es": "eslint . --cache",
    "lint:style": "stylelint --cache \"**/*.{css,scss}\"",
    "format": "prettier --write --cache ."
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": [
      "pnpm run format --ignore-unknown"
    ],
    "packages/**/*.{js,mjs,cjs,ts,mts,cts}": [
      "pnpm run lint:es --fix"
    ],
    "packages/**/*.{css,scss}": [
      "pnpm run lint:style --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "lint-staged": "^17.2.0",
    "prettier": "3.9.6",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@10.20.0"
}
